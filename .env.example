# Supabase — get these from your Supabase project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Hero video and poster (can also be set via Admin > Settings)
VITE_HERO_VIDEO_URL=
VITE_HERO_POSTER_URL=https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=1920&q=80

# NEVER put your Supabase service_role key here — it must only be used server-side
